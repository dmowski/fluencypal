rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /publicImages/{imageId} {
      allow read: if true;
    }

    match /publicVideo/{videoId} {
      allow read: if true;
    }

    // Shared-books blob storage.
    // Access is governed by the /books/{bookId} Firestore document:
    //   - Any member (ownerUserId or userIds) may read and write blobs.
    //   - Only the owner may delete.
    //
    // Writes are capped at 25 MB to limit abuse.
    match /books/{bookId}/{fileName=**} {
      function bookDoc() {
        return firestore.get(/databases/(default)/documents/books/$(bookId)).data;
      }

      function isMember() {
        return request.auth != null && (
          bookDoc().ownerUserId == request.auth.uid ||
          request.auth.uid in bookDoc().userIds
        );
      }

      allow read: if isMember();

      allow write: if isMember()
        && request.resource.size < 25 * 1024 * 1024;

      allow delete: if request.auth != null
        && bookDoc().ownerUserId == request.auth.uid;
    }
  }
}