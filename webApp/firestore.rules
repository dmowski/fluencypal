rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    
    match /battles/{document=**} {
    	allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /community/spaces/spaceList/{document=**} {
    	allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /game/gamePoints {
    	allow read: if true;
      allow write: if false;
    }

    match /audioCache/{document=**} {
    	allow read: if true;
      allow write: if isSignedIn();
    }

    match /chat/{document=**} {
    	allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /stats/{document=**} {
    	allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /stories/{document=**} {
    	allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /news/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    
    match /game/gameLastVisit {
    	allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /dailyQuestionsAnswers/{answerId}/likes/{likeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /dailyQuestionsAnswers/{answerId} {

      function isOwner() {
        return request.auth != null && resource.data.authorUserId == request.auth.uid;
      }

      function isCreator() {
        return request.auth != null && request.resource.data.authorUserId == request.auth.uid;
      }

      function isPublished() {
        return resource.data.isPublished == true;
      }

      // Strict schema (adjust if you add/remove fields)
      function hasOnlyAllowedKeys(d) {
        return d.keys().hasOnly([
          'authorUserId',
          'questionId',
          'answerLanguage',
          'transcript',
          'isPublished',
          'createdAtIso',
          'updatedAtIso',
          'aiSuggestion',
        ]);
      }

      function isValidDQA(d) {
        return hasOnlyAllowedKeys(d)
          && d.authorUserId is string
          && d.questionId is string
          && d.answerLanguage is string // tighten if you validate SupportedLanguage set elsewhere
          && d.transcript is string
          && d.isPublished is bool
          && d.createdAtIso is string
          && d.updatedAtIso is string;
      }

      /* ---------- reads ---------- */
      // Per-document evaluation makes this safe for both get and list queries.
      allow get, list: if isPublished() || isOwner();

      /* ---------- creates ---------- */
      // Author must be the signed-in user; require valid schema.
      allow create: if isCreator() && isValidDQA(request.resource.data);

      /* ---------- updates ---------- */
      // Only the author can update; keep authorUserId and createdAtIso immutable; require valid schema.
      allow update: if isOwner()
                    && isValidDQA(request.resource.data)
                    && request.resource.data.authorUserId == resource.data.authorUserId
                    && request.resource.data.createdAtIso == resource.data.createdAtIso;

      /* ---------- deletes ---------- */
      // Only the author can delete.
      allow delete: if isOwner();
    }

    match /game/gameAvatars {
    	allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /game2/gamePoints {
    	allow read: if true;
      allow write: if false;
    }
    
    match /game2/gameLastVisit {
    	allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /game2/gameAvatars {
    	allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /game2/gameUserNames {
    	allow read: if true;
      allow write: if isSignedIn();
    }

    match /game2/gameUserAchievements {
    	allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId} {
      
      // Allow user to read and write their own document (/users/{userId})
      allow read, write: if isUser(userId);

      // Allow read-write for conversations
      match /conversations/{conversationId} {
        allow read, write: if isUser(userId);
      }

      // Allow read-write for stats
      match /stats/{statId} {
        allow read, write: if isUser(userId);
      }

      match /dailyTasks/{taskId} {
        allow read, write: if isUser(userId);
      }

      match /progressStats/{statId} {
        allow read, write: if isUser(userId);
      }
      
      // Allow read-write for phrases
      match /phraseCorrections/{correction} {
        allow read, write: if isUser(userId);
      }
      
      // Allow read-write for goals
      match /goals/{goalId} {
        allow read, write: if isUser(userId);
      }
      
      // Allow read-write for Interview Preparation
      match /interview/{interviewId} {
        allow read, write: if isUser(userId);
      }

      // homeworks
      match /homeworks/{homeworkId} {
        allow read, write: if isUser(userId);
      }

      // Allow read-write for usage document
      match /usage {
        allow read, write: if isUser(userId);
      }

      // Allow read-only for totalUsage specifically
      match /usage/totalUsage {
        allow read: if isUser(userId);
        allow write: if false;
      }

      // Allow read-only access to all usageLogs documents
      match /usageLogs/{logId} {
        allow read: if isUser(userId);
        allow write: if false;
      }

      // Allow read-only access to all payments documents
      match /payments/{paymentId} {
        allow read: if isUser(userId);
        allow write: if false;
      }
      
      // Allow read-write for quizSurvey
      match /quiz2/{id} {
        allow read, write: if isUser(userId);
      }

      // Allow read-write for community space settings
      match /settings/communitySpace {
        allow read, write: if isUser(userId);
      }

      // Deny all other unspecified documents under userId by default
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Root-level shared books collection.
    // ownerUserId is the creator; userIds holds additional collaborators.
    // memberIds = [ownerUserId, ...userIds] — kept in sync by the client push
    // side. Used as the query target for array-contains subscription queries.
    match /books/{bookId} {

      function isBookMember() {
        return isSignedIn() && (
          resource.data.ownerUserId == request.auth.uid ||
          request.auth.uid in resource.data.userIds
        );
      }

      function isBookOwner() {
        return isSignedIn() && resource.data.ownerUserId == request.auth.uid;
      }

      function isBookCreator() {
        return isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      }

      // Single-document read: any member may access.
      allow get: if isBookMember();

      // Collection query: must use where('memberIds', 'array-contains', uid).
      // Security rules align with that query filter.
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;

      // Only the creator can create a new document (they set themselves as owner).
      allow create: if isBookCreator();

      // Any member can update (e.g. collaborators can save highlights).
      // ownerUserId and userIds may only be changed by the owner,
      // EXCEPT a non-owner may remove only themselves from the book.
      allow update: if isBookMember()
        && (
          isBookOwner()
          || (
            // Non-owner updating non-membership fields (e.g. highlights).
            request.resource.data.ownerUserId == resource.data.ownerUserId &&
            request.resource.data.userIds == resource.data.userIds
          )
          || (
            // Non-owner self-removal: userIds and memberIds must each be the
            // existing list with only the current user removed.
            request.resource.data.ownerUserId == resource.data.ownerUserId &&
            request.resource.data.userIds.toSet() ==
              resource.data.userIds.toSet().difference([request.auth.uid].toSet()) &&
            request.resource.data.memberIds.toSet() ==
              resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
          )
        );

      // Only the owner can delete.
      allow delete: if isBookOwner();
    }

    match /blogs/{blogId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /versions/{versionId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
  }
}
