rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBlogAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'dmowski.alex@gmail.com'
        || request.auth.uid == 'Mq2HfU3KrXTjNyOpPXqHSPg5izV2'
      );
    }

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    
    match /battles/{document=**} {
    	allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /community/spaces/spaceList/{document=**} {
    	allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /game/gamePoints {
    	allow read: if true;
      allow write: if false;
    }

    match /audioCache/{document=**} {
    	allow read: if true;
      allow write: if isSignedIn();
    }

    match /chat/{document=**} {
    	allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /stats/{document=**} {
    	allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /stories/{document=**} {
    	allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /news/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    
    match /game/gameLastVisit {
    	allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /dailyQuestionsAnswers/{answerId}/likes/{likeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /dailyQuestionsAnswers/{answerId} {

      function isOwner() {
        return request.auth != null && resource.data.authorUserId == request.auth.uid;
      }

      function isCreator() {
        return request.auth != null && request.resource.data.authorUserId == request.auth.uid;
      }

      function isPublished() {
        return resource.data.isPublished == true;
      }

      // Strict schema (adjust if you add/remove fields)
      function hasOnlyAllowedKeys(d) {
        return d.keys().hasOnly([
          'authorUserId',
          'questionId',
          'answerLanguage',
          'transcript',
          'isPublished',
          'createdAtIso',
          'updatedAtIso',
          'aiSuggestion',
        ]);
      }

      function isValidDQA(d) {
        return hasOnlyAllowedKeys(d)
          && d.authorUserId is string
          && d.questionId is string
          && d.answerLanguage is string // tighten if you validate SupportedLanguage set elsewhere
          && d.transcript is string
          && d.isPublished is bool
          && d.createdAtIso is string
          && d.updatedAtIso is string;
      }

      /* ---------- reads ---------- */
      // Per-document evaluation makes this safe for both get and list queries.
      allow get, list: if isPublished() || isOwner();

      /* ---------- creates ---------- */
      // Author must be the signed-in user; require valid schema.
      allow create: if isCreator() && isValidDQA(request.resource.data);

      /* ---------- updates ---------- */
      // Only the author can update; keep authorUserId and createdAtIso immutable; require valid schema.
      allow update: if isOwner()
                    && isValidDQA(request.resource.data)
                    && request.resource.data.authorUserId == resource.data.authorUserId
                    && request.resource.data.createdAtIso == resource.data.createdAtIso;

      /* ---------- deletes ---------- */
      // Only the author can delete.
      allow delete: if isOwner();
    }

    match /userDailyQuestions/{questionId} {
      function isOwner() {
        return isSignedIn() && resource.data.authorUserId == request.auth.uid;
      }

      function isCreator() {
        return isSignedIn() && request.resource.data.authorUserId == request.auth.uid;
      }

      function isText(value, max) {
        return value is string && value.size() > 0 && value.size() <= max;
      }

      function isValidUserDailyQuestion(d) {
        return d.keys().hasOnly([
            'id',
            'authorUserId',
            'title',
            'description',
            'dayKey',
            'imageUrl',
            'createdAtIso',
            'updatedAtIso',
          ])
          && d.id == questionId
          && d.authorUserId is string
          && isText(d.title, 180)
          && isText(d.description, 1500)
          && d.createdAtIso is string
          && d.updatedAtIso is string;
      }

      allow get, list: if isSignedIn();

      allow create: if isCreator() && isValidUserDailyQuestion(request.resource.data);

      allow update: if isBlogAdmin()
        && isValidUserDailyQuestion(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'description', 'imageUrl', 'updatedAtIso']);

      allow delete: if isOwner() || isBlogAdmin();
    }

    match /game/gameAvatars {
    	allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /game2/gamePoints {
    	allow read: if true;
      allow write: if false;
    }
    
    match /game2/gameLastVisit {
    	allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /game2/gameAvatars {
    	allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /game2/gameUserNames {
    	allow read: if true;
      allow write: if isSignedIn();
    }

    match /game2/gameUserAchievements {
    	allow read: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId} {
      
      // Allow user to read and write their own document (/users/{userId})
      allow read, write: if isUser(userId);

      // Allow read-write for conversations
      match /conversations/{conversationId} {
        allow read, write: if isUser(userId);
      }

      // Allow read-write for stats
      match /stats/{statId} {
        allow read, write: if isUser(userId);
      }

      match /dailyTasks/{taskId} {
        allow read, write: if isUser(userId);
      }

      match /progressStats/{statId} {
        allow read, write: if isUser(userId);
      }
      
      // Allow read-write for phrases
      match /phraseCorrections/{correction} {
        allow read, write: if isUser(userId);
      }
      
      // Allow read-write for goals
      match /goals/{goalId} {
        allow read, write: if isUser(userId);
      }
      
      // Allow read-write for Interview Preparation
      match /interview/{interviewId} {
        allow read, write: if isUser(userId);
      }

      // homeworks
      match /homeworks/{homeworkId} {
        allow read, write: if isUser(userId);
      }

      match /quizzes/{quizId} {
        allow read, write: if isUser(userId);
      }

      match /interactiveLessons/{languageCode} {
        allow read, write: if isUser(userId);
      }

      // Allow read-write for usage document
      match /usage {
        allow read, write: if isUser(userId);
      }

      // Allow read-only for totalUsage specifically
      match /usage/totalUsage {
        allow read: if isUser(userId);
        allow write: if false;
      }

      // Allow read-only access to all usageLogs documents
      match /usageLogs/{logId} {
        allow read: if isUser(userId);
        allow write: if false;
      }

      // Allow read-only access to all payments documents
      match /payments/{paymentId} {
        allow read: if isUser(userId);
        allow write: if false;
      }

      match /openAiLive/{docId} {
        allow read: if isUser(userId);
        allow write: if false;
      }
      
      // Allow read-write for quizSurvey
      match /quiz2/{id} {
        allow read, write: if isUser(userId);
      }

      // Allow read-write for community space settings
      match /settings/communitySpace {
        allow read, write: if isUser(userId);
      }

      // Deny all other unspecified documents under userId by default
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Root-level shared books collection.
    // ownerUserId is the creator; userIds holds additional collaborators.
    // memberIds = [ownerUserId, ...userIds] — kept in sync by the client push
    // side. Used as the query target for array-contains subscription queries.
    match /books/{bookId} {

      function isBookMember() {
        return isSignedIn() && (
          resource.data.ownerUserId == request.auth.uid ||
          request.auth.uid in resource.data.userIds
        );
      }

      function isBookOwner() {
        return isSignedIn() && resource.data.ownerUserId == request.auth.uid;
      }

      function isBookCreator() {
        return isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      }

      // Single-document read: any member may access.
      allow get: if isBookMember();

      // Collection query: must use where('memberIds', 'array-contains', uid).
      // Security rules align with that query filter.
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;

      // Only the creator can create a new document (they set themselves as owner).
      allow create: if isBookCreator();

      // Any member can update (e.g. collaborators can save highlights).
      // ownerUserId and userIds may only be changed by the owner,
      // EXCEPT a non-owner may remove only themselves from the book.
      allow update: if isBookMember()
        && (
          isBookOwner()
          || (
            // Non-owner updating non-membership fields (e.g. highlights).
            request.resource.data.ownerUserId == resource.data.ownerUserId &&
            request.resource.data.userIds == resource.data.userIds
          )
          || (
            // Non-owner self-removal: userIds and memberIds must each be the
            // existing list with only the current user removed.
            request.resource.data.ownerUserId == resource.data.ownerUserId &&
            request.resource.data.userIds.toSet() ==
              resource.data.userIds.toSet().difference([request.auth.uid].toSet()) &&
            request.resource.data.memberIds.toSet() ==
              resource.data.memberIds.toSet().difference([request.auth.uid].toSet())
          )
        );

      // Only the owner can delete.
      allow delete: if isBookOwner();
    }

    match /blogs/{blogId} {
      allow read: if isBlogAdmin();
      allow write: if isBlogAdmin();

      match /versions/{versionId} {
        allow read: if isBlogAdmin();
        allow write: if isBlogAdmin();
      }
    }

    match /blogMetadata/category {
      allow read: if isBlogAdmin();
      allow write: if isBlogAdmin();

      match /categories/{categoryId} {
        allow read: if isBlogAdmin();
        allow write: if isBlogAdmin();
      }
    }

    // FluencyPal Calls. Admins schedule the meeting. Members RSVP as themselves.
    match /fluencyCalls/{callId} {
      function isText(value, min, max) {
        return value is string && value.size() >= min && value.size() <= max;
      }

      function isValidCall(d) {
        return d.keys().hasOnly([
            'id',
            'startsAtIso',
            'link',
            'status',
            'createdAtIso',
            'updatedAtIso',
            'stoppedAtIso',
          ])
          && d.id == callId
          && isText(d.startsAtIso, 20, 40)
          && isText(d.link, 1, 2000)
          && (d.status == 'scheduled' || d.status == 'stopped')
          && isText(d.createdAtIso, 20, 40)
          && isText(d.updatedAtIso, 20, 40)
          && (d.stoppedAtIso == null || isText(d.stoppedAtIso, 20, 40));
      }

      allow read: if isSignedIn();
      allow create: if isBlogAdmin() && isValidCall(request.resource.data);
      allow update: if isBlogAdmin()
        && isValidCall(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAtIso == resource.data.createdAtIso;
      allow delete: if isBlogAdmin();

      match /rsvps/{userId} {
        function isValidRsvp(d) {
          return d.keys().hasOnly(['userId', 'createdAtIso'])
            && d.userId == userId
            && d.userId == request.auth.uid
            && isText(d.createdAtIso, 20, 40);
        }

        allow read: if isSignedIn();
        allow create: if isUser(userId) && isValidRsvp(request.resource.data);
        allow update: if isUser(userId)
          && isValidRsvp(request.resource.data)
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isUser(userId);
      }
    }

    // A member's request for the next call. The API creates it. An admin can accept or reject it.
    match /fluencyCallRequests/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isBlogAdmin());
      allow create: if false;
      allow update, delete: if isBlogAdmin();
    }

    // Voice Chat: all mutations go through Admin SDK APIs.
    // Clients may only read their own membership + entitlement docs.
    match /voiceChat/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /voiceChatEntitlements/{userId} {
      allow read: if isUser(userId);
      allow write: if false;
    }

    match /voiceChatMembers/{userId} {
      allow read: if isUser(userId);
      allow write: if false;
    }

    // Custom analytics: client SDK has no access. Writes go through Admin SDK
    // ingest; reads go through the admin journey API (DEV_EMAILS).
    match /customAnalyticsVisitors/{visitorId} {
      allow read, write: if false;
    }

    match /customAnalyticsEvents/{eventId} {
      allow read, write: if false;
    }

    match /voiceChatMessages/{messageId} {
      allow read, write: if false;
    }
  }
}
