# Experimental: custom realtime WebSocket (Experimental Lab → Just Talk custom realtime)
# pnpm dev (emulator) uses _DEV; pnpm dev:prod uses _PROD. Legacy _URL is fallback for either.
NEXT_PUBLIC_REALTIME_WS_URL_DEV=ws://127.0.0.1:8081
NEXT_PUBLIC_REALTIME_WS_URL_PROD=wss://fluencypal-realtime.fly.dev
# NEXT_PUBLIC_REALTIME_WS_URL=

SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_DSN=
# Optional; if empty, prod script injects git SHA as SENTRY_RELEASE.
SENTRY_RELEASE=

# Local `pnpm prod` (Vercel CLI). Create at https://vercel.com/account/tokens
# Use a dashboard token with the longest expiration — `vercel login` sessions expire.
VERCEL_TOKEN=
# Optional: skip `vercel link` if .vercel/project.json is missing.
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=