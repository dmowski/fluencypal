{
  "name": "trim-audios",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "load": "tsx src/index.ts load",
    "process": "tsx src/index.ts process",
    "upload": "tsx src/index.ts upload",
    "stories": "tsx src/index.ts stories",
    "dropAllFilesInStorage": "tsx src/index.ts remove",
    "clean": "tsx src/index.ts clean",
    "check": "tsx src/index.ts check",
    "run-all": "npm run load && npm run process && npm run upload && npm run stories && npm run clean",
    "all": "pnpm run run-all",
    "typecheck": "tsc --noEmit",
    "restore-libs": "node node_modules/ffmpeg-static/install.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^13.9.0",
    "p-limit": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "^7.5.6"
    }
  }
}
