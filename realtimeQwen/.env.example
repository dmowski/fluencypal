# International (Singapore) Model Studio key. Never expose this in the browser.
DASHSCOPE_API_KEY=

# Pricing region. Must match the key: singapore | beijing
QWEN_REGION=singapore

QWEN_MODEL=qwen-audio-3.0-realtime-flash

# Optional. Defaults follow QWEN_REGION.
# Singapore: https://maas.qwencloudapi.com/api/v1/webrtc/realtime
# Beijing workspace: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/webrtc/realtime
# QWEN_WEBRTC_URL=
