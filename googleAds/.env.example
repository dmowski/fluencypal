# OAuth client from the Google Cloud project that has Google Ads API access.
# Prefer googleAds/.secrets/client_secret.json from the Cloud Console download.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Written by `pnpm ads auth` into googleAds/.secrets/oauth.json. Optional here.
GOOGLE_ADS_REFRESH_TOKEN=

# 10-digit Google Ads customer id, hyphens optional. Not the AW- conversion tag.
GOOGLE_ADS_CUSTOMER_ID=
# Manager account id, only when calling a client account through a manager.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional. Developer tokens were sunset on 2026-09-09 and are ignored by the API.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Cloud project that owns the credentials. API access level is granted to this project.
GOOGLE_CLOUD_PROJECT=fluencypal-campaigns

# Optional path. Defaults to googleAds/.secrets/service-account.json.
# GOOGLE_ADS_SERVICE_ACCOUNT_FILE=
