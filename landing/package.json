{
  "name": "fluency-landing",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "browserslist": {
    "production": [
      "chrome >= 100",
      "edge >= 100",
      "firefox >= 100",
      "safari >= 15.4",
      "ios_saf >= 15.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:https": "node scripts/dev.mjs --experimental-https",
    "build": "SENTRY_LOAD_DOTENV=0 next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "test:unit:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js --watch",
    "test:e2e": "playwright test",
    "e2e": "pnpm test:e2e",
    "e2e:ui": "pnpm test:e2e:ui",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "ai-translate": "node --env-file=.env.tool updateLanguage.mjs",
    "lang": "lingui extract --clean && npm run ai-translate && lingui compile",
    "fix-prettier": "prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audio:marin-talk": "node --env-file=../webApp/.env scripts/generateMarinTalkAudio.mjs",
    "create-git-build": "git tag -a build-landing-$(date +%Y-%m-%d--%H-%M-%S) -m 'Build at $(date)'",
    "prod": "pnpm lang && node scripts/prod.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lingui/cli": "^6.9.0",
    "@lingui/core": "^6.9.0",
    "@lingui/loader": "^6.9.0",
    "@lingui/react": "^6.9.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@types/negotiator": "^0.6.5",
    "@types/three": "^0.181.0",
    "dayjs": "^1.11.23",
    "gettext-parser": "^8.0.0",
    "glslify-loader": "^2.0.0",
    "lil-gui": "^0.21.0",
    "lucide-react": "^0.555.0",
    "markdown-to-jsx": "^9.10.3",
    "negotiator": "^1.1.0",
    "next": "16.4.0",
    "openai": "^6.49.0",
    "prettier": "^3.9.9",
    "raw-loader": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-lottie-player": "^2.1.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@lingui/swc-plugin": "^6.7.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "6.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lighthouse": "^13.5.0",
    "playwright-lighthouse": "^4.0.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "webpack": "^5.111.1"
  }
}
