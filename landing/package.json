{
  "name": "fluency-landing",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "browserslist": {
    "production": [
      "chrome >= 100",
      "edge >= 100",
      "firefox >= 100",
      "safari >= 15.4",
      "ios_saf >= 15.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:https": "next dev --turbopack --experimental-https",
    "build": "SENTRY_LOAD_DOTENV=0 next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:e2e": "playwright test",
    "e2e": "pnpm test:e2e",
    "e2e:ui": "pnpm test:e2e:ui",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "ai-translate": "node --env-file=.env.tool updateLanguage.mjs",
    "lang": "lingui extract && npm run ai-translate && lingui compile",
    "lang-clean": "lingui extract --clean && npm run lang",
    "fix-prettier": "prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-git-build": "git tag -a build-landing-$(date +%Y-%m-%d--%H-%M-%S) -m 'Build at $(date)'",
    "prod": "SENTRY_LOAD_DOTENV=0 SENTRY_RELEASE=$(git rev-parse HEAD) vercel build --prod && pnpm run create-git-build && vercel deploy --prebuilt --prod --archive=tgz"
  },
  "dependencies": {
    "@datafast/ai-crawl": "^1.0.7",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lingui/cli": "^5.9.5",
    "@lingui/core": "^5.9.5",
    "@lingui/loader": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@types/negotiator": "^0.6.4",
    "@types/three": "^0.181.0",
    "dayjs": "^1.11.20",
    "gettext-parser": "^8.0.0",
    "glslify-loader": "^2.0.0",
    "lil-gui": "^0.21.0",
    "lucide-react": "^0.555.0",
    "markdown-to-jsx": "^9.7.16",
    "negotiator": "^1.0.0",
    "next": "16.2.6",
    "openai": "^6.37.0",
    "prettier": "^3.8.3",
    "raw-loader": "^4.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-lottie-player": "^2.1.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@lingui/swc-plugin": "^5.11.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ajv": "6.14.0",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^13.4.0",
    "playwright-lighthouse": "^4.0.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "webpack": "^5.106.2"
  }
}
