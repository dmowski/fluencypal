msgid "I aware that this is a simulation and not a real legal consultation."
msgstr ""
"Tôi nhận thức rằng đây là một mô phỏng và không phải là một tư vấn pháp "
"luật thực sự."

#: src/features/RolePlay/scenarios/meeting-with-psychologist.ts:31
#. js-lingui-explicit-id
msgid "I aware that this is a simulation and not a real medical consultation."
msgstr ""
