# Server
REALTIME_PORT=8081
NODE_ENV=development

# Per-IP rate limits (disabled automatically in NODE_ENV=test)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=200
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_AUTH_VERIFY_MAX=30
# RATE_LIMIT_WS_MAX=20

# Close WebSocket session after 10 min without mic/control activity (0 = off)
# SESSION_IDLE_TIMEOUT_MS=600000
# Comma-separated browser origins for CORS + WebSocket.
# Production (Fly): https://fluencypal-realtime.fly.dev,https://app.fluencypal.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional explicit public URL (also merged into ALLOWED_ORIGINS)
# PUBLIC_APP_URL=https://fluencypal-realtime.fly.dev

# Test client: point at deployed WSS host (optional, local dev uses Vite proxy)
# VITE_REALTIME_WS_URL=wss://fluencypal-realtime.fly.dev

# OpenAI (required for STT / LLM / TTS in later steps)
OPENAI_API_KEY=

# Firebase admin
FIREBASE_STORAGE_SERVICE_ACCOUNT_CREDS=
FIREBASE_PROJECT_ID=dark-lang
FIREBASE_STORAGE_BUCKET=dark-lang.firebasestorage.app
IS_FIREBASE_EMULATOR=false

# Model defaults (server-side only; change here to swap models)
DEFAULT_STT_MODEL=gpt-4o-transcribe
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_TTS_MODEL=gpt-4o-mini-tts
