{
  "name": "fluencypal-realtime",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "tsc",
    "build:client": "vite build --config client/vite.config.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit && pnpm build:client",
    "typecheck": "pnpm lint",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:voice": "vitest run --config vitest.e2e.voice.config.ts",
    "test:e2e:browser": "playwright test",
    "test:e2e:voice:browser": "playwright test --config playwright.voice.config.ts",
    "test:e2e:browser:ui": "playwright test --ui",
    "e2e:fixtures:voice": "tsx e2e/scripts/generateVoiceFixtures.ts",
    "e2e:fixtures:normalize": "tsx e2e/scripts/normalizeUserRecording.ts",
    "test:all": "pnpm test && pnpm test:e2e && pnpm test:e2e:browser && pnpm build:client",
    "load:smoke": "tsx scripts/loadSmoke.ts",
    "prod": "fly deploy",
    "prod:open": "open https://fluencypal-realtime.fly.dev/",
    "audit": "pnpm audit"
  },
  "pnpm": {
    "overrides": {
      "uuid": ">=11.1.1"
    }
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "firebase-admin": "^13.9.0",
    "openai": "^6.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "ffmpeg-static": "^5.2.0",
    "firebase": "^12.10.0",
    "react-firebase-hooks": "^5.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.8",
    "ws": "^8.19.0"
  }
}
